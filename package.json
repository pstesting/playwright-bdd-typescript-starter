{
  "name": "playwright-bdd-typescript-starter",
  "version": "1.0.0",
  "description": "A comprehensive Playwright BDD TypeScript starter template with accessibility testing, Allure reporting, and BrowserStack support",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "cucumber-js --profile headed",
    "test:browserstack": "cucumber-js --profile browserstack",
    "test:accessibility": "playwright test src/accessibility/accessibility.test.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "bdd",
    "cucumber",
    "typescript",
    "accessibility",
    "allure",
    "browserstack",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.3.1",
    "@playwright/test": "^1.42.1",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "allure-commandline": "^2.27.0",
    "allure-cucumberjs": "^2.15.0",
    "allure-playwright": "^2.15.0",
    "axe-core": "^4.8.4",
    "axe-playwright": "^1.2.3",
    "eslint": "^8.57.0",
    "playwright": "^1.42.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}
